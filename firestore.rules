rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    //
    // Collection: users
    // Fields: uid, email, displayName, role (patient|admin), photoURL
    //
    // Collection: doctors
    // Fields: id, name, specialty, bio, image, department
    //
    // Collection: appointments
    // Fields: id, patientUid, doctorId, doctorName, date, time, status, notes
    //
    // Collection: prescriptions
    // Fields: id, patientUid, doctorName, date, medicine, instructions, status
    //
    // ===============================================================

    // ===============================================================
    // Helper Functions
    // ===============================================================
    
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() && 
        (
          request.auth.token.email == "seomtayyab@gmail.com" ||
          request.auth.token.email == "adminmedicare@gmail.com"
        );
    }

    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'email', 'role']) &&
             data.uid is string && data.uid.size() < 128 &&
             data.email is string && data.email.size() < 256 &&
             data.role in ['patient', 'admin'];
    }

    function isValidAppointment(data) {
      return data.keys().hasAll(['id', 'patientUid', 'doctorId', 'date', 'time', 'status']) &&
             data.id is string && data.id.size() < 128 &&
             data.patientUid is string && data.patientUid.size() < 128 &&
             (data.patientUid == request.auth.uid || isAdmin()) &&
             data.status in ['pending', 'confirmed', 'cancelled', 'prescription-issued'];
    }

    function isValidPrescription(data) {
      return data.keys().hasAll(['id', 'patientUid', 'doctorName', 'date', 'medicine', 'instructions', 'status']) &&
             data.keys().hasOnly(['id', 'patientUid', 'doctorName', 'date', 'medicine', 'instructions', 'status', 'createdAt', 'appointmentId']) &&
             data.id is string && data.id.size() < 128 &&
             data.patientUid is string && data.patientUid.size() < 128 &&
             data.medicine is string && data.medicine.size() > 0 &&
             data.status in ['active', 'completed', 'checked'] &&
             (!('appointmentId' in data) || (data.appointmentId is string && data.appointmentId.size() < 128));
    }

    function isValidDoctor(data) {
      return data.keys().hasAll(['id', 'name', 'specialty', 'department', 'bio', 'image']) &&
             data.keys().hasOnly(['id', 'name', 'specialty', 'department', 'bio', 'image']) &&
             data.id is string &&
             data.name is string && data.name.size() > 0 && data.name.size() < 128 &&
             data.specialty is string &&
             data.bio is string &&
             data.image is string &&
             data.department in ['Cardiology', 'Neurology', 'Pediatrics', 'Orthopedics', 'Dermatology', 'General'];
    }

    // ===============================================================
    // Rules
    // ===============================================================

    match /users/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow create: if isAuthenticated() && isValidUser(request.resource.data) && (isOwner(uid) || isAdmin());
      allow update: if isAuthenticated() && isValidUser(request.resource.data) && (isOwner(uid) || isAdmin());
    }

    match /doctors/{doctorId} {
      allow read: if true; // Publicly viewable
      allow create, update: if isAdmin() && isValidDoctor(request.resource.data);
      allow delete: if isAdmin();
    }

    match /appointments/{appointmentId} {
      allow read: if isAuthenticated() && (resource.data.patientUid == request.auth.uid || isAdmin());
      allow create: if isAuthenticated() && isValidAppointment(request.resource.data);
      allow update: if isAuthenticated() && (resource.data.patientUid == request.auth.uid || isAdmin()) && isValidAppointment(request.resource.data);
      allow delete: if isAdmin();
    }

    match /prescriptions/{pxId} {
      allow read: if isAuthenticated() && (resource.data.patientUid == request.auth.uid || isAdmin());
      allow create: if isAdmin() && isValidPrescription(request.resource.data);
      allow update: if isAdmin() && isValidPrescription(request.resource.data);
      allow delete: if isAdmin();
    }
  }
}
